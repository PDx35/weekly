# ───────────────────────────────────────────────────────────────────────────
# FreshMart environment variables. Copy to `.env.local` and fill in.
# Only NEXT_PUBLIC_* values reach the browser; everything else is server-only.
# ───────────────────────────────────────────────────────────────────────────

# Canonical site origin (used for metadata, sitemap, robots, JSON-LD)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Firebase Web SDK (client) — Firebase console → Project settings → Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin SDK (server only) — from a service-account JSON key.
# Keep the private key on one line with literal \n escapes, wrapped in quotes.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Razorpay — test-mode keys in dev/preview, live keys only in production
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
